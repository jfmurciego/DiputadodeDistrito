{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diputadodedistrito.invalid/schemas/g10-resumen-maquina.schema.json",
  "title": "G10 Resumen de máquina",
  "type": "object",
  "required": ["schema_version", "task_id", "fingerprint", "attempt", "status", "last_valid_checkpoint", "metrics", "artifacts", "recommended_action", "agent_required"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"type": "string"},
    "failure_class": {"type": ["string", "null"]},
    "failed_stage": {"type": ["string", "null"]},
    "last_valid_checkpoint": {"type": ["string", "null"]},
    "metrics": {"type": "object"},
    "artifacts": {"type": "array"},
    "recommended_action": {"type": "string"},
    "agent_required": {"type": "boolean"}
  }
}
