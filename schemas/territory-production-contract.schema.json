{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jfmurciego/DiputadodeDistrito/schemas/territory-production-contract.schema.json",
  "title": "DDD production territory contract",
  "description": "Contrato estructural mínimo para admitir M01-M06. La coherencia entre campos y rutas la verifica ddd_core.territory_contract.",
  "type": "object",
  "required": ["meta", "io", "territory_contract", "modulos", "validation"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["procedure_name", "territory_id", "territory", "run_name", "year", "scope", "schema_version", "status"],
      "properties": {"territory_id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}}
    },
    "territory_contract": {
      "type": "object",
      "required": ["unit_id_role", "admin_level_1_role", "admin_level_2_role", "province_codes", "k_districts", "district_apportionment", "population_floor_ratio", "population_cap_ratio", "target_tolerance_ratio", "require_graph_contiguity", "require_single_admin_level_1_per_district", "require_municipality_discipline", "oversized_municipality_rule", "municipality_atomicity_limit_ratio", "require_auditable_district_catalogue"],
      "properties": {
        "province_codes": {"type": "array", "minItems": 1, "uniqueItems": true},
        "k_districts": {"type": "integer", "minimum": 1},
        "population_floor_ratio": {"type": "number", "exclusiveMinimum": 0},
        "population_cap_ratio": {"type": "number", "exclusiveMinimum": 1},
        "target_tolerance_ratio": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "modulos": {
      "type": "object",
      "required": ["modulo_01_preparar_base_territorial", "modulo_02_construir_adyacencias", "modulo_03_construir_grafo", "modulo_04_generar_semillas", "modulo_05_optimizar_distritos", "modulo_06_consolidar_distritos"],
      "properties": {
        "modulo_05_optimizar_distritos": {
          "type": "object",
          "properties": {
            "population_repair": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "max_depth", "max_transfer_set", "max_candidates", "max_seconds", "seed"],
              "properties": {
                "enabled": {"type": "boolean"},
                "max_depth": {"type": "integer", "minimum": 1},
                "max_transfer_set": {"type": "integer", "minimum": 1},
                "max_candidates": {"type": "integer", "minimum": 1},
                "max_seconds": {"type": "number", "exclusiveMinimum": 0},
                "seed": {"type": "integer"}
              }
            },
            "unit_id_field": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {
              "if": {
                "properties": {"population_repair": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]}},
                "required": ["population_repair"]
              },
              "then": {"required": ["in_graph_json", "province_field", "unit_id_field"]}
            }
          ]
        }
      }
    },
    "validation": {"type": "object"}
  }
}
