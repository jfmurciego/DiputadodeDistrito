{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diputadodedistrito.invalid/schemas/g10-plan-lote.schema.json",
  "title": "G10 Plan de lote",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lot_id", "budget", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "lot_id": {"type": "string", "minLength": 1},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_minutes", "max_parallel", "max_agent_cycles_per_fingerprint"],
      "properties": {
        "runner_minutes": {"type": "integer", "minimum": 0},
        "max_parallel": {"type": "integer", "minimum": 1},
        "max_agent_cycles_per_fingerprint": {"type": "integer", "minimum": 0}
      }
    },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "territory", "stage", "depends_on", "max_attempts", "timeout_minutes", "estimated_runner_minutes", "success_contract", "action"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "territory": {"type": "string", "minLength": 1},
          "stage": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "priority": {"enum": ["blocking", "normal", "experimental"]},
          "max_attempts": {"type": "integer", "minimum": 0},
          "timeout_minutes": {"type": "integer", "minimum": 1},
          "estimated_runner_minutes": {"type": "integer", "minimum": 0},
          "requires_agent_on_failure": {"type": "boolean"},
          "success_contract": {"type": "string", "minLength": 1},
          "action": {"enum": ["g10_selftest", "validate_config", "territory_m01_m06"]},
          "config": {"type": "string"}
        }
      }
    }
  }
}
