{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ddd.campaign-manifest/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","campaign_id","data_edition","execution_mode","optimization_algorithm","candidate_count","fail_fast","max_parallel","retry_failed","campaign_confirmation","territories"],
  "properties": {
    "schema": {"const":"ddd.campaign-manifest/1.0"},
    "campaign_id": {"type":"string","minLength":1},
    "data_edition": {"const":"2025"},
    "execution_mode": {"const":"Reutilizar progreso existente"},
    "optimization_algorithm": {"const":"GerryChain 50"},
    "candidate_count": {"const":50},
    "fail_fast": {"const":false},
    "max_parallel": {"const":5},
    "retry_failed": {"const":false},
    "campaign_confirmation": {"const":"EXECUTE_CAMPAIGN_CONFIRMED"},
    "territories": {"type":"array","minItems":5,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["slot","territory_id","territory_name","publication_mode"],"properties":{"slot":{"type":"string","pattern":"^0[1-5]$"},"territory_id":{"type":"string","minLength":1},"territory_name":{"type":"string","minLength":1},"publication_mode":{"enum":["electoral","territorial_only"]}}}}
  }
}
