{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DDD READ_ONLY executor 1.3.0; 2026-10-11; new scoped output",
  "type": "object", "additionalProperties": false,
  "properties": {
    "task": {"type":"string","minLength":1},
    "head": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "inputs_manifest_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status": {"type":"string","enum":["READY_FOR_REVIEW","BLOCKED","WAIT_OWNER"]},
    "criteria_verified": {"type":"array","items":{"type":"string","minLength":1}},
    "evidence": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "tests": {"type":"array","items":{"type":"string","minLength":1}},
    "limitations": {"type":"array","items":{"type":"string","minLength":1}}
  },
  "required":["task","head","inputs_manifest_sha256","status","criteria_verified","evidence","tests","limitations"]
}
